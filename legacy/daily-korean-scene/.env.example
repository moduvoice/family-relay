# Copy to .env (never commit .env). All values are optional; defaults shown.

# LLM provider (Amazon Bedrock). Credentials come from the normal AWS chain:
# a named profile below, env vars, or the Lambda/EC2 role.
DKS_LLM_PROVIDER=bedrock
DKS_AWS_PROFILE=
DKS_BEDROCK_REGION=us-east-1
# Comma-separated "region|modelId" pools. Each region x inference profile has its own
# requests-per-minute quota; calls rotate and move on when one is throttled.
DKS_GRADER_MODEL=us-east-1|global.anthropic.claude-sonnet-4-6,us-east-1|us.anthropic.claude-sonnet-4-6
DKS_ORCHESTRATOR_MODEL=us-east-1|global.anthropic.claude-haiku-4-5-20251001-v1:0,us-east-1|us.anthropic.claude-haiku-4-5-20251001-v1:0

# State: sqlite (local) or dynamodb (deployed)
DKS_STORE=sqlite
DKS_SQLITE_PATH=data/dks.sqlite3
DKS_DYNAMODB_TABLE=daily-korean-scene

# Content (defaults to ../content/scenes if present, else fixtures/scenes)
DKS_SCENES_DIR=
DKS_AUDIO_DIR=

# MCP server
DKS_DEMO_MODE=1
DKS_DEFAULT_TIMEZONE=America/Los_Angeles
DKS_PUBLIC_BASE_URL=
DKS_ALLOWED_ORIGINS=
DKS_MCP_STATELESS=0
DKS_MCP_JSON_RESPONSE=0

# Simulator
DKS_MCP_URL=http://127.0.0.1:8790/mcp
DKS_DEMO_LEARNER=demo-learner
