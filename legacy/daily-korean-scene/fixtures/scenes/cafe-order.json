    {"id": "l04", "speaker": "barista", "ko": "사이즈는 어떤 걸로 드릴까요?", "romanization": "saijeuneun eotteon geollo deurilkkayo?", "en": "What size would you like?", "audio": null, "hints_en": ""},
    {"id": "l05", "speaker": "learner", "ko": "큰 걸로 주세요.", "romanization": "keun geollo juseyo.", "en": "A large one, please.", "audio": null,
