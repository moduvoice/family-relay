    {"id": "l02", "speaker": "barista", "ko": "어서 오세요. 주문하시겠어요?", "romanization": "eoseo oseyo. jumunhasigesseoyo?", "en": "Welcome. Are you ready to order?", "audio": null, "hints_en": ""},
    {"id": "l03", "speaker": "learner", "ko": "아이스 아메리카노 한 잔 주세요.", "romanization": "aiseu amerikano han jan juseyo.", "en": "One iced americano, please.", "audio": null,
     "expected": ["아이스 아메리카노 한 잔 주세요", "아이스 아메리카노 하나 주세요", "아이스 아메리카노 주세요", "아아 한 잔 주세요"],
