    {"id": "l06", "speaker": "barista", "ko": "드시고 가세요, 아니면 가져가세요?", "romanization": "deusigo gaseyo, animyeon gajyeogaseyo?", "en": "For here, or to go?", "audio": null, "hints_en": ""},
    {"id": "l07", "speaker": "learner", "ko": "가져갈게요.", "romanization": "gajyeogalgeyo.", "en": "I'll take it to go.", "audio": null,
