    {"id": "l08", "speaker": "barista", "ko": "네, 사천오백 원입니다. 카드로 하시겠어요?", "romanization": "ne, sacheon-obaek wonimnida. kadeuro hasigesseoyo?", "en": "Okay, that's 4,500 won. Will you pay by card?", "audio": null, "hints_en": ""},
    {"id": "l09", "speaker": "learner", "ko": "네, 카드로 할게요.", "romanization": "ne, kadeuro halgeyo.", "en": "Yes, I'll pay by card.", "audio": null,
