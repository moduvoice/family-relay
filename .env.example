# Copy to .env (never commit .env).
# One switch picks every stage; any single variable below set explicitly still wins.
#   aws   (submission default)  Amazon Transcribe -> Bedrock Nova 2 Lite -> Amazon Polly, speaker = familyvoice
#   local (device CPU)          silero VAD + sherpa-onnx parakeet 110M int8 -> Nova 2 Lite -> Piper, familyvoice int8
#   gpu   (GPU voice box)       Qwen3-ASR-1.7B -> Nova 2 Lite -> VoxCPM2, familyvoice
#   demo                        browser speech + stand-in speaker module (the "Speaking now" switch)
FR_PROFILE=aws
FR_AWS_PROFILE=

# --- AWS services (profile aws) ---
FR_TRANSCRIBE_REGION=us-east-1
# optional Transcribe custom vocabulary with the spelling of the family's names (a name list, not voice enrollment):
#   aws transcribe create-vocabulary --vocabulary-name family-relay-names --language-code en-US --phrases Sunhee Grandma
FR_TRANSCRIBE_VOCABULARY=
FR_NOVA_REGION=us-east-1
FR_NOVA_MODEL=us.amazon.nova-2-lite-v1:0
FR_POLLY_REGION=us-east-1
FR_POLLY_ENGINE=standard
FR_POLLY_VOICE=Salli
FR_POLLY_VOICE_KO=Seoyeon

# --- speaker module (familyvoice) ---
# FR_SPEAKER_MODULE=familyvoice.app_adapter:FamilyVoiceSpeaker
# FV_MODEL=r34            # ResNet34-LM
# FV_PROFILE=server       # device = int8

# --- on-device (profile local) ---
FR_LOCAL_MODELS=models
FR_LOCAL_THREADS=2
FR_PIPER_VOICE=vits-piper-en_US-amy-low

# --- GPU voice box (profile gpu) ---
FR_STT_URL=http://127.0.0.1:8002/stt
FR_TTS_URL=http://127.0.0.1:8000/v1/audio/speech

# --- any OpenAI-compatible LLM instead of Bedrock (development) ---
# FR_LLM_PROVIDER=gptproxy
# FR_OPENAI_BASE_URL=http://127.0.0.1:8788/v1
# FR_OPENAI_MODEL=gpt-6-luna

# --- relay ---
FR_MESSAGE_TTL_HOURS=24
FR_NOTIFY_WEBHOOK_URL=
FR_DEFAULT_TIMEZONE=America/Los_Angeles
FR_DEMO_MODE=1
FR_STORE=sqlite
FR_SQLITE_PATH=data/relay.sqlite3
FR_MCP_URL=http://127.0.0.1:8790/mcp
FR_DEMO_HOUSEHOLD=demo-family
